{% for user in tunnel_users %}
Match User {{ user }}
    PermitTTY no
    X11Forwarding no
    AllowAgentForwarding no
    AllowTcpForwarding remote
    ForceCommand /bin/false
    StreamLocalBindMask 0117
    # Replace a socket file left at the same path by a closed or dead connection,
    # so clients with a fixed socket name can reconnect at once
    StreamLocalBindUnlink yes
{% endfor %}
